{
  "extends": "../../tsconfig.settings.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@ai-front/domain": ["../../packages/domain/src"],
      "@ai-front/domain/*": ["../../packages/domain/src/*"],
      "@ai-front/transport": ["../../packages/transport/src"],
      "@ai-front/transport/*": ["../../packages/transport/src/*"],
      "@ai-front/ui": ["../../packages/ui/src"],
      "@ai-front/ui/*": ["../../packages/ui/src/*"],
      "@ai-front/renderers": ["../../packages/renderers/src"],
      "@ai-front/renderers/*": ["../../packages/renderers/src/*"],
      "@ai-front/plugin-sdk": ["../../packages/plugin-sdk/src"],
      "@ai-front/plugin-sdk/*": ["../../packages/plugin-sdk/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
